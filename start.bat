@echo off
chcp 65001 > nul
title ร้านข้าวขาหมูพาสเทล หวานละมุน
cls
echo ====================================================================
echo        🌸 ระบบร้านข้าวขาหมูพาสเทล "หวานละมุน" (Wan Lamun) 🌸
echo ====================================================================
echo.
echo  [1/3] ตรวจเช็คและเคลียร์พอร์ต 3000 เก่าที่อาจค้างอยู่...
for /f "tokens=5" %%a in ('netstat -aon ^| findstr :3000 ^| findstr LISTENING') do (
    taskkill /F /PID %%a >nul 2>&1
)

echo  [2/3] กำลังเริ่มทำงานเซิร์ฟเวอร์ Node.js และฐานข้อมูล SQLite (khamoo.db)...
cd /d "%~dp0"

echo  [3/3] เปิดเบราว์เซอร์อัตโนมัติ:
echo       * หน้าร้านลูกค้า:               http://localhost:3000
echo       * ระบบหลังร้าน/ห้องครัว (POS):      http://localhost:3000/admin.html
echo.
echo ====================================================================
echo  ⚠️  ข้อควรจำ: กรุณา "เปิดหน้าต่างสีดำนี้ค้างไว้" ขณะใช้งานระบบ
echo     (หากปิดหน้าต่างนี้ เว็บจะไม่สามารถเชื่อมต่อฐานข้อมูลได้)
echo ====================================================================
echo.

start "" "http://localhost:3000/admin.html"
node server.js

echo.
echo [แจ้งเตือน] เซิร์ฟเวอร์หยุดทำงานแล้ว
pause
